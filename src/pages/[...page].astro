---
import Base from '../layouts/Base.astro';
import { getEntry, getCollection } from 'astro:content';
import { fetchAwsBuilderContent } from '../utils/aws-builder-fetcher.js';

export async function getStaticPaths({ paginate }) {
  const notesEntries = await getCollection('notes');
  const noteArticles = notesEntries
    .filter(entry => entry.id !== 'index.md')
    .map(entry => ({
      title: entry.data.title,
      link: `/notes/${entry.slug}`,
      description: entry.data.description,
      pubDate: entry.data.publishedAt,
    }));

  const awsArticles = await fetchAwsBuilderContent();

  const allItems = [...noteArticles, ...awsArticles]
    .filter(item => item.pubDate)
    .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());

  return paginate(allItems, { pageSize: 10 });
}

const { page } = Astro.props;

const homeContent = await getEntry('home', 'index');
if (!homeContent) throw new Error('Home content not found');
const { Content } = await homeContent.render();

function pageUrl(n) {
  return n === 1 ? '/' : `/${n}/`;
}
---

<Base title={homeContent.data.title} description={homeContent.data.description}>
  <main class="mx-auto max-w-4xl px-6 py-12">

    {page.currentPage === 1 && (
      <div class="prose dark:prose-invert max-w-none">
        <Content />
      </div>
    )}

    <section class={page.currentPage === 1 ? "mt-12 border-t border-gray-200 dark:border-gray-700 pt-8" : ""}>
      <div class="space-y-6">
        {page.data.map((item) => (
          <article class="pb-6">
            <h3 class="text-lg font-medium mb-2 flex items-baseline justify-between">
              <a
                href={item.link}
                target={item.link.startsWith('/') ? undefined : '_blank'}
                rel={item.link.startsWith('/') ? undefined : 'noopener noreferrer'}
                class="text-blue-600 dark:text-blue-400 hover:underline"
              >
                {item.title}
              </a>
              <time class="text-sm text-gray-400 dark:text-gray-500 ml-4 flex-shrink-0">
                {new Date(item.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </time>
            </h3>
            {item.description && (
              <p class="text-gray-600 dark:text-gray-300 mb-2 leading-relaxed">
                {item.description}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>

    {page.lastPage > 1 && (
      <nav class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700 flex items-center justify-center gap-2">
        {page.url.prev ? (
          <a href={page.url.prev} class="px-3 py-1 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400">← prev</a>
        ) : (
          <span class="px-3 py-1 text-sm text-gray-300 dark:text-gray-600">← prev</span>
        )}
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
          <a
            href={pageUrl(n)}
            class={n === page.currentPage
              ? 'px-3 py-1 text-sm rounded bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 font-medium'
              : 'px-3 py-1 text-sm rounded text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400'}
          >
            {n}
          </a>
        ))}
        {page.url.next ? (
          <a href={page.url.next} class="px-3 py-1 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400">next →</a>
        ) : (
          <span class="px-3 py-1 text-sm text-gray-300 dark:text-gray-600">next →</span>
        )}
      </nav>
    )}

  </main>
</Base>
